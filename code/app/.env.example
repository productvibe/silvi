# The settings this app reads. Copy this file to .env and fill it in.
# The silvi CLI writes it from each connector's connector.json:
# `silvi add` and `silvi remove` add and take out a connector's lines.

# The connector a report reads when its frontmatter names none.
SILVI_CONNECTOR=csv

# Excel files
EXCEL_DIR=data/excel  # Folder of .xlsx files, from app/; each sheet is a table, <file>_<sheet>

# CSV files
CSV_DIR=data/csv  # Folder of .csv files, from app/; each file is a table

# JSON files
JSON_DIR=data/json  # Folder of .json files, from app/; each file (an array of objects) is a table

# SQLite
SQLITE_PATH=data/app.sqlite  # The database file, from app/; opened read-only

# SQL Server
SQLSERVER_HOST=sql.example.com  # Server host
SQLSERVER_PORT=1433  # Port
SQLSERVER_DB=analytics  # Database name
SQLSERVER_USER=reports_reader  # A read-only login
SQLSERVER_PASSWORD=  # That login's password
SQLSERVER_ENCRYPT=true  # Encrypt the connection: true or false

# Postgres
POSTGRES_URL=postgres://user:password@host:5432/db  # Connection string

# MySQL
MYSQL_URL=mysql://user:password@host:3306/db  # Connection string

# BigQuery
BIGQUERY_PROJECT=my-project  # Google Cloud project id the queries run (and are billed) in
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # Path to a service account key file with BigQuery read access
BIGQUERY_LOCATION=EU  # Dataset location, e.g. EU or US; optional

# Redshift
REDSHIFT_HOST=my-cluster.abc123.eu-north-1.redshift.amazonaws.com  # Cluster endpoint, without the port
REDSHIFT_PORT=5439  # Port
REDSHIFT_DB=analytics  # Database name
REDSHIFT_USER=reports_reader  # A read-only user
REDSHIFT_PASSWORD=  # That user's password
